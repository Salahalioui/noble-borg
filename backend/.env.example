# Server Settings
HOST=0.0.0.0
PORT=8001
DEBUG=True
CORS_ORIGINS=["http://localhost:3000", "http://localhost:3001", "https://your-vercel-app.vercel.app"]

# AI Intelligence Keys (Gemini 2.5 Flash / Gemini Council)
# Get free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# TradFi & Stocks API Keys (Optional, fallback to yfinance if not set)
# Get free key at: https://finnhub.io/register (60 req/min free)
FINNHUB_API_KEY=your_finnhub_api_key_here

# Federal Reserve Economic Data (FRED) Key (Optional, fallback to mock macro values)
# Get free key at: https://fredaccount.stlouisfed.org/apikeys (120 req/min free)
FRED_API_KEY=your_fred_api_key_here

# News & Sentiment API Key (Optional, fallback to Google RSS News)
# Get free key at: https://www.marketaux.com/register (100 req/day free)
MARKETAUX_API_KEY=your_marketaux_api_key_here

# Telegram / Discord Webhook Notifications (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# Default Trading & Capital Rules ($50 Micro-Cap Baseline)
DEFAULT_PAPER_BALANCE=50.0
MAX_RISK_PER_TRADE_PCT=0.02
MIN_RISK_REWARD_RATIO=2.0
